    {
      "blocks": ["BARREL"],
      "vars": { "titleKey": "gloss.preview.theme.title.barrel", "accent": "#F2D451" }
    },
    {
      "blocks": ["*COPPER_CHEST"],
      "vars": { "titleKey": "gloss.preview.theme.title.copper_chest", "accent": "#F2A535" }
