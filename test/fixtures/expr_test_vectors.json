{
  "vectors": [
    { "expr": "1 + 2 * 3", "expect": 7 },
    { "expr": "(1 + 2) * 3", "expect": 9 },
    { "expr": "10 - 3", "expect": 7 },
    { "expr": "2 * 3.5", "expect": 7 },
    { "expr": "7 / 2", "expect": 3.5 },
    { "expr": "7 % 3", "expect": 1 },
    { "expr": "-5 + 10", "expect": 5 },
    { "expr": "-(-5)", "expect": 5 },
    { "expr": "10 % 4", "expect": 2 },
    { "expr": "-1 % 3", "expect": -1 },

    { "expr": "5 > 3", "expect": true },
    { "expr": "5 < 3", "expect": false },
    { "expr": "5 >= 5", "expect": true },
    { "expr": "5 <= 4", "expect": false },
    { "expr": "5 == 5", "expect": true },
    { "expr": "5 != 5", "expect": false },
    { "expr": "'a' == 'a'", "expect": true },
    { "expr": "'a' != 'b'", "expect": true },
    { "expr": "true == true", "expect": true },
    { "expr": "true != false", "expect": true },

    { "expr": "true && false", "expect": false },
    { "expr": "true || false", "expect": true },
    { "expr": "true && true", "expect": true },
    { "expr": "false || false", "expect": false },

    { "expr": "!true", "expect": false },
    { "expr": "!false", "expect": true },

    { "expr": "progress * 8 > i ? 1 : 0", "vars": { "progress": 0.5, "i": 3 }, "expect": 1 },
    { "expr": "1 < 0 ? 10 : 20", "expect": 20 },

    { "expr": "'x' + 5", "expect": "x5" },
    { "expr": "'n=' + 3.5", "expect": "n=3.5" },
    { "expr": "'flag:' + true", "expect": "flag:true" },
    { "expr": "name + '!'", "vars": { "name": "Bob" }, "expect": "Bob!" },
    { "expr": "flag && true", "vars": { "flag": true }, "expect": true },

    { "expr": "str(54.0)", "expect": "54" },
    { "expr": "str(3.5)", "expect": "3.5" },
    { "expr": "str(1000000000)", "expect": "1000000000" },
    { "expr": "str(true)", "expect": "true" },
    { "expr": "str('hi')", "expect": "hi" },
    { "expr": "str(fixed(3.14159, 2))", "expect": "3.14" },

    { "expr": "fixed(2, 0)", "expect": "2" },
    { "expr": "fixed(10, 3)", "expect": "10.000" },
    { "expr": "fixed(1, 20)", "expect": "1.00000000000000000000" },

    { "expr": "#FF0000FF == rgb(0,0,255)", "expect": true },
    { "expr": "#F00 == rgb(255,0,0)", "expect": true },
    { "expr": "rgb(300,-10,128) == rgb(255,0,128)", "expect": true },
    { "expr": "argb(128,10,20,30)", "expect": "#800A141E" },
    { "expr": "alpha(#FFFFFFFF, 128)", "expect": "#80FFFFFF" },
    { "expr": "#F00", "expect": "#FFFF0000" },

    { "expr": "mix(#FF000000, #FFFFFFFF, 0.25)", "expect": "#FF404040" },
    { "expr": "mix(#FF000000, #FFFFFFFF, 0.5)", "expect": "#FF808080" },
    { "expr": "mix(#FF000000, #FFFFFFFF, -1)", "expect": "#FF000000" },
    { "expr": "mix(#FF000000, #FFFFFFFF, 2)", "expect": "#FFFFFFFF" },

    { "expr": "palette([1,2,3], 4)", "expect": 2 },
    { "expr": "palette([10,20,30], -1)", "expect": 30 },
    { "expr": "palette(colors, 1)", "vars": { "colors": [10, 20, 30] }, "expect": 20 },

    { "expr": "plain('&6&lChest')", "expect": "Chest" },
    { "expr": "plain('Salt & Pepper')", "expect": "Salt & Pepper" },
    { "expr": "plain('')", "expect": "" },
    { "expr": "readable('IRON_ORE')", "expect": "Iron Ore" },
    { "expr": "readable('chest')", "expect": "Chest" },
    { "expr": "readable('')", "expect": "" },
    { "expr": "readable('IRON_')", "expect": "Iron" },
    { "expr": "readable('_IRON')", "expect": " Iron" },
    { "expr": "readable('IRON__ORE')", "expect": "Iron  Ore" },

    { "expr": "clamp(15, 0, 10)", "expect": 10 },
    { "expr": "clamp(-5, 0, 10)", "expect": 0 },
    { "expr": "min(3, 7)", "expect": 3 },
    { "expr": "max(3, 7)", "expect": 7 },
    { "expr": "floor(3.7)", "expect": 3 },
    { "expr": "ceil(3.2)", "expect": 4 },
    { "expr": "round(2.5)", "expect": 3 },
    { "expr": "round(-2.5)", "expect": -2 },
    { "expr": "abs(-7)", "expect": 7 },
    { "expr": "mod(-1, 3)", "expect": 2 },
    { "expr": "lerp(0, 10, 0.25)", "expect": 2.5 },
    { "expr": "pow(2, 8)", "expect": 256 },
    { "expr": "pow(9, 0.5)", "expect": 3 },
    { "expr": "smoothstep(0, 1, -1)", "expect": 0 },
    { "expr": "smoothstep(0, 1, 0.5)", "expect": 0.5 },
    { "expr": "smoothstep(0, 1, 2)", "expect": 1 },
    { "expr": "sin(0)", "expect": 0 },
    { "expr": "cos(0)", "expect": 1 },
    { "expr": "cos(3.14159265)", "expect": -1 },
    { "expr": "sin(1.5707963)", "expect": 0.9999999999999997 },

    { "expr": "1 / 0", "error": true },
    { "expr": "5 % 0", "error": true },
    { "expr": "missing + 1", "error": true },
    { "expr": "bogus(1)", "error": true },
    { "expr": "'a' < 'b'", "error": true },
    { "expr": "true + 1", "error": true },
    { "expr": "1 ? 2 : 3", "error": true },
    { "expr": "1 && true", "error": true },
    { "expr": "1 == '1'", "error": true },
    { "expr": "clamp(1, 2)", "error": true },
    { "expr": "unknownVar", "error": true },
    { "expr": "palette([], 0)", "error": true },
    { "expr": "mod(1)", "error": true },
    { "expr": "mod(1, 2, 3)", "error": true },
    { "expr": "mod(1, 0)", "error": true },
    { "expr": "pow(-1, 0.5)", "error": true },
    { "expr": "pow(2)", "error": true },
    { "expr": "smoothstep(1, 1, 0.5)", "error": true },
    { "expr": "smoothstep(0, 1)", "error": true },
    { "expr": "fixed(1, -1)", "error": true },
    { "expr": "fixed(1, 21)", "error": true },
    { "expr": "fixed(1, 2.5)", "error": true }
  ]
}
